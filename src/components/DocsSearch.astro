---
// Pagefind's index and default UI bundle (/pagefind/pagefind-ui.js) only exist after
// `astro build && pagefind --site dist` has run — see package.json's "build" script.
// In dev, the dynamic import below fails gracefully and the panel says so.
---

<button type="button" class="docs-search-trigger" id="docs-search-trigger" aria-haspopup="dialog">
  <span>Search docs</span>
  <kbd>Ctrl K</kbd>
</button>

<div class="docs-search-modal" id="docs-search-modal" role="dialog" aria-modal="true" aria-label="Search documentation" hidden>
  <div class="docs-search-backdrop" id="docs-search-backdrop"></div>
  <div class="docs-search-panel">
    <div id="docs-search-results"></div>
  </div>
</div>

<script>
  let pagefindLoaded = false;
  const trigger = document.getElementById('docs-search-trigger');
  const modal = document.getElementById('docs-search-modal');
  const backdrop = document.getElementById('docs-search-backdrop');

  // This component's markup starts out nested inside .docs-sidebar (see DocsLayout.astro),
  // which DocsLayout's own entrance animation briefly gives a GSAP transform. A `position:
  // fixed` descendant of any transformed ancestor is scoped to that ancestor's box instead of
  // the viewport — so on wide screens, opening search mid-animation trapped this full-screen
  // modal inside the narrow 220px sidebar column instead of centering it on the page. Moving it
  // to a direct child of <body> up front, before that animation ever starts, sidesteps the
  // containing-block rule entirely rather than racing it.
  if (modal) document.body.appendChild(modal);

  // pagefind-ui.js is a classic script (it sets window.PagefindUI directly), not an ES
  // module — it only exists after `pagefind --site dist` runs post-build, so it can't be a
  // static <script> tag either. Load it as a one-off classic script rather than import().
  function loadPagefindUI() {
    return new Promise<void>((resolve, reject) => {
      const script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('Failed to load Pagefind UI'));
      document.head.appendChild(script);
    });
  }

  async function openSearch() {
    if (!modal) return;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';

    if (!pagefindLoaded) {
      pagefindLoaded = true;
      try {
        await loadPagefindUI();
        // @ts-ignore -- global set by the classic script above
        new window.PagefindUI({ element: '#docs-search-results', showSubResults: true, showImages: false });
      } catch {
        const results = document.getElementById('docs-search-results');
        if (results) results.textContent = 'Search is only available on the deployed site.';
      }
    }

    modal.querySelector('input')?.focus();
  }

  function closeSearch() {
    if (!modal) return;
    modal.hidden = true;
    document.body.style.overflow = '';
  }

  trigger?.addEventListener('click', openSearch);
  backdrop?.addEventListener('click', closeSearch);

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (modal?.hidden) openSearch();
      else closeSearch();
    }
    if (e.key === 'Escape') closeSearch();
  });
</script>

<style>
  .docs-search-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-2) var(--space-3);
    margin-bottom: var(--space-4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    font-family: var(--font-sans);
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .docs-search-trigger:hover {
    border-color: var(--accent-cyan);
    color: var(--text-secondary);
  }

  .docs-search-trigger kbd {
    padding: 1px 6px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 11px;
  }

  /* Explicit — an unconditional `display: flex` on .docs-search-modal below would otherwise
     override the browser's built-in `[hidden] { display: none }` rule, since author CSS always
     wins over the UA stylesheet regardless of specificity. Without this, the modal (and its
     empty, not-yet-populated results panel) renders permanently on top of the page. */
  .docs-search-modal[hidden] {
    display: none;
  }

  .docs-search-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: 10vh var(--space-6) var(--space-6);
  }

  .docs-search-backdrop {
    position: absolute;
    inset: 0;
    /* No backdrop-filter blur — see site-header's comment in Layout.astro for why. */
    background: color-mix(in srgb, var(--bg-primary) 88%, transparent);
  }

  .docs-search-panel {
    position: relative;
    width: 100%;
    max-width: 640px;
    max-height: 60vh;
    overflow-y: auto;
    padding: var(--space-4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5);

    /* Theme Pagefind's default UI to match the site — these custom properties
       cascade into the dynamically-injected search markup even though Astro's
       scoped-style attribute can't reach elements Pagefind adds at runtime. */
    --pagefind-ui-primary: var(--accent-cyan);
    --pagefind-ui-text: var(--text-primary);
    --pagefind-ui-background: var(--bg-secondary);
    --pagefind-ui-border: var(--border-color);
    --pagefind-ui-tag: var(--bg-tertiary);
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-font: var(--font-sans);
  }

  /* Pagefind injects its results into the DOM after its script loads (see the script above),
     so Astro's scoped-style attribute never reaches these elements — every rule below needs
     :global() or it silently does nothing. The CSS custom properties above are the exception:
     those inherit through the DOM tree regardless of scoping.

     Every selector is also prefixed with .docs-search-panel: Pagefind's own stylesheet pairs
     each class with a Svelte hash class (e.g. .pagefind-ui__message.svelte-e9gkc3), which
     outweighs a single bare class here regardless of load order. Matching that specificity by
     nesting under our own panel class — rather than reaching for !important — is what actually
     wins the cascade. */

  /* Pagefind's own stylesheet renders matched terms as a raw browser <mark> — bright yellow on
     black, unthemed and jarring next to the site's purple/cyan palette in both themes. */
  :global(.docs-search-panel .pagefind-ui__result-excerpt mark) {
    background: color-mix(in srgb, var(--accent-cyan) 25%, transparent);
    color: var(--text-primary);
    border-radius: var(--radius-sm);
    padding: 0 2px;
    font-weight: 600;
  }

  :global(.docs-search-panel .pagefind-ui__result-title a) {
    transition: var(--transition-smooth);
  }

  :global(.docs-search-panel .pagefind-ui__result-title a:hover) {
    color: var(--accent-cyan);
  }

  /* A divider per top-level result reads as a scannable list instead of one dense block —
     nested sub-results stay undivided since they already belong visually to their parent. */
  :global(.docs-search-panel .pagefind-ui__result) {
    border-bottom: 1px solid var(--border-color);
  }

  :global(.docs-search-panel .pagefind-ui__result:last-child) {
    border-bottom: none;
  }

  /* A left rule ties each sub-result back to its parent page instead of sitting flush at the
     same indent, which otherwise reads as a second, unrelated top-level result. */
  :global(.docs-search-panel .pagefind-ui__result-nested) {
    margin-top: var(--space-3);
    padding-left: var(--space-4);
    border-left: 2px solid var(--border-color);
  }

  :global(.docs-search-panel .pagefind-ui__message) {
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  :global(.docs-search-panel .pagefind-ui__search-clear) {
    color: var(--text-muted);
    transition: var(--transition-smooth);
  }

  :global(.docs-search-panel .pagefind-ui__search-clear:hover) {
    color: var(--accent-cyan);
  }
</style>
