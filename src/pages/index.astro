---
import Layout from '../layouts/Layout.astro';
import DownloadButton from '../components/DownloadButton';
import { getLatestRelease } from '../lib/releases';
import { TAGLINE, PRODUCT_NAME } from '../config';

const release = await getLatestRelease();

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: PRODUCT_NAME,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows, macOS',
  description: TAGLINE,
  ...(release.version && { softwareVersion: release.version }),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const features = [
  {
    title: 'AI Assistant & Agent Mode',
    description: 'Chat with AI grounded in your codebase, or hand off a task to Agent Mode — it reads files, proposes edits for your review, and runs terminal commands with an approval gate at every step.',
    href: '/docs/ai-assistant',
    demo: '/demos/ai-assistant.png',
  },
  {
    title: 'Real Language Intelligence',
    description: 'A genuine language server (not a heuristic) powers completion, hover docs, go-to-definition, and live diagnostics — the same experience you get in any LSP-backed editor.',
    href: '/docs/editing',
    demo: '/demos/editing-intellisense.gif',
  },
  {
    title: 'Integrated Debugger',
    description: 'Set breakpoints, step through code, and inspect the call stack and variables — a real Debug Adapter Protocol client, not a bolted-on console.log.',
    href: '/docs/debugging',
    demo: '/demos/debugging.png',
  },
  {
    title: 'Git, Built In',
    description: 'A full source control panel, an embedded interactive commit graph, and GitHub pull request / issue review — without leaving the editor.',
    href: '/docs/git',
    demo: '/demos/git.gif',
  },
  {
    title: 'Code Map & Impact Analysis',
    description: 'A visual dependency graph of your workspace, plus AI-assisted "Analyze Impact" — see what a change could break, and which tests to run, before you touch anything.',
    href: '/docs/code-map',
    demo: '/demos/code-map.png',
  },
  {
    title: 'Notebook Cells',
    description: 'Run Python cells against a persistent kernel with real cross-cell state, live streaming output, and .ipynb files that round-trip cleanly with Jupyter.',
    href: '/docs/notebooks',
    demo: '/demos/notebooks.gif',
  },
  {
    title: 'Extensions',
    description: 'A marketplace for installing extensions, and the tooling to build and publish your own — themes, language servers, debug adapters, and AI tools.',
    href: '/docs/extensions',
    demo: '/demos/extensions.png',
  },
];

const pillars = [
  {
    title: 'Its own architecture',
    description: 'Built from scratch — not a fork of VS Code or any other editor. An independent codebase, top to bottom.',
  },
  {
    title: 'Real language intelligence',
    description: 'A genuine Language Server Protocol client powers completion and diagnostics — not a heuristic bolted on top.',
  },
  {
    title: 'Approval gates, not autopilot',
    description: 'Agent Mode proposes every file edit and terminal command for your review — configurable per tool in Agent Profiles, from read-only to full autonomy.',
  },
  {
    title: 'Bring your own model',
    description: 'Anthropic Claude, OpenAI GPT-4o, Google Gemini, or a fully local model via Ollama — your choice, set in Settings.',
  },
];

const faqs = [
  { q: 'Is SDE Code free?', a: 'Yes — free to download and use.' },
  { q: 'Is it built on VS Code?', a: "No. It's an original editor core and architecture, built from scratch." },
  { q: 'What platforms are supported?', a: 'Windows and macOS today.' },
  { q: 'Which AI providers can I use?', a: 'Claude, GPT-4o, Gemini, or a local model via Ollama — configured in Settings → AI Provider Credentials.' },
  { q: 'Can I build my own extensions?', a: 'Yes — themes, snippets, language servers, and more, published to the built-in marketplace.' },
  { q: "Where's the source, and how do I report a bug?", a: 'SDE Code is built in the open on GitHub — file an issue there.' },
];
---

<Layout title="AI-first IDE" description={TAGLINE}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareAppSchema)} />

  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="eyebrow hero-eyebrow">Available for Windows &amp; macOS</span>
      <h1 class="hero-h1">
        <span class="hero-word">The</span> <span class="hero-word hero-word-accent">AI-first</span> <span class="hero-word">IDE.</span>
      </h1>
      <p class="hero-sub">A desktop IDE with AI woven into editing, debugging, and git — its own architecture from the ground up.</p>
      <div class="hero-cta">
        <DownloadButton client:load version={release.version} windowsAssetUrl={release.windowsAssetUrl} macAssetUrl={release.macAssetUrl} />
      </div>

      <div class="ide-mock tick-frame" aria-hidden="true">
        <span class="tick tick-tl" aria-hidden="true"></span>
        <span class="tick tick-tr" aria-hidden="true"></span>
        <span class="tick tick-bl" aria-hidden="true"></span>
        <span class="tick tick-br" aria-hidden="true"></span>

        <div class="ide-mock-tabs">
          <div class="ide-mock-tab ide-mock-tab-active">agent.ts<span class="ide-mock-dot"></span></div>
          <div class="ide-mock-tab">utils.ts</div>
        </div>

        <div class="ide-mock-body">
          <div class="ide-mock-files">
            <div>src/</div>
            <div class="ide-mock-file-active">agent.ts</div>
            <div>utils.ts</div>
            <div>types.ts</div>
            <div>package.json</div>
          </div>

          <div class="ide-mock-code">
            <div><span class="ide-mock-line-no">1</span><span class="ide-mock-kw">import</span> {"{"} AgentMode {"}"} <span class="ide-mock-kw">from</span> <span class="ide-mock-str">'sde/agent'</span>;</div>
            <div><span class="ide-mock-line-no">2</span></div>
            <div><span class="ide-mock-line-no">3</span><span class="ide-mock-kw">export function</span> run() {"{"}</div>
            <div><span class="ide-mock-line-no">4</span>&nbsp;&nbsp;<span class="ide-mock-kw">const</span> plan = AgentMode.propose(task);</div>
            <div><span class="ide-mock-line-no">5</span>&nbsp;&nbsp;<span class="ide-mock-kw">return</span> plan.awaitApproval();<span class="ide-mock-cursor"></span></div>
            <div><span class="ide-mock-line-no">6</span>{"}"}</div>
          </div>

          <div class="ide-mock-agent">
            <div class="ide-mock-agent-status"><span class="ide-mock-agent-dot"></span>Agent — running</div>
            <div class="ide-mock-bubble ide-mock-bubble-user">Refactor run() to await approval before applying.</div>
            <div class="ide-mock-bubble ide-mock-bubble-agent">Proposed 1 change to agent.ts. Approve to apply?</div>
            <div class="ide-mock-agent-actions">
              <button class="btn btn--primary ide-mock-approve" type="button" tabindex="-1">Approve</button>
              <button class="btn btn--secondary ide-mock-reject" type="button" tabindex="-1">Reject</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="showcase">
    <div class="container">
      <span class="showcase-eyebrow">Selected capabilities</span>

      {features.map((f, i) => (
        <div class="feature-block">
          <span class="feature-fig">FIG.{String(i + 1).padStart(2, '0')}</span>
          <div class="feature-block-body">
            <div>
              <h2>{f.title}</h2>
              <p>{f.description}</p>
              <a class="showcase-link" href={f.href}>Read the docs →</a>
            </div>
            {f.demo && (
              <img class="feature-demo" src={f.demo} alt={`${f.title} demo`} loading="lazy" width="380" height="238" />
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="pillars">
    <div class="container">
      <span class="showcase-eyebrow">Why SDE Code</span>
      <div class="pillars-grid">
        {pillars.map((p) => (
          <div class="pillar-card">
            <h3>{p.title}</h3>
            <p>{p.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="faq">
    <div class="container">
      <span class="showcase-eyebrow">Frequently asked</span>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
  tl.from('.hero-eyebrow', { opacity: 0, y: 14, duration: 0.5 })
    .from('.hero-word', { opacity: 0, y: 26, stagger: 0.06, duration: 0.6 }, '-=0.25')
    .from('.hero-sub', { opacity: 0, y: 16, duration: 0.5 }, '-=0.3')
    .from('.hero-cta', { opacity: 0, y: 16, duration: 0.5 }, '-=0.35')
    .from('.ide-mock', { opacity: 0, y: 40, scale: 0.98, duration: 0.7 }, '-=0.25');

  gsap.to('.hero-glow', {
    y: 140,
    ease: 'none',
    scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 0.6 },
  });

  gsap.to('.ide-mock', {
    y: -60,
    ease: 'none',
    scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 0.6 },
  });

  document.querySelectorAll<HTMLElement>('.feature-block, .pillar-card, .faq-item').forEach((el) => {
    gsap.from(el, {
      opacity: 0,
      y: 36,
      duration: 0.6,
      ease: 'power2.out',
      scrollTrigger: { trigger: el, start: 'top 85%' },
    });
  });

  // Respect reduced-motion: skip all of the above by killing every tween/trigger this page created.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    ScrollTrigger.getAll().forEach((t) => t.kill());
    gsap.globalTimeline.clear();
    document.querySelectorAll<HTMLElement>('.hero-eyebrow, .hero-word, .hero-sub, .hero-cta, .ide-mock, .feature-block, .pillar-card, .faq-item').forEach((el) => {
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
  }
</script>

<style>
  .hero {
    position: relative;
    padding: var(--space-16) 0 var(--space-12);
    text-align: center;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .hero {
      padding: var(--space-24) 0 var(--space-16);
    }
  }

  .hero-glow {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    max-width: 160vw;
    height: 480px;
    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--accent-purple) 24%, transparent), transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .hero-h1 {
    /* Fluid between mobile and desktop instead of a fixed 60px that wraps awkwardly on narrow screens. */
    font-size: clamp(2.25rem, 5vw + 1rem, var(--font-size-3xl));
    max-width: 780px;
  }

  .hero-word {
    display: inline-block;
  }

  .hero-word-accent {
    color: var(--accent-cyan);
  }

  .hero-sub {
    max-width: 560px;
    color: var(--text-secondary);
    font-size: clamp(var(--font-size-base), 2vw + 0.5rem, var(--font-size-md));
  }

  .hero-cta {
    display: flex;
    justify-content: center;
  }

  /* The IDE mockup — a static recreation of the app's editor + Agent panel, not a screenshot
     (no build artifact to grab one from at page-build time). Kept in sync by eye with the real
     app's editor/agent-panel layout; update here if either changes noticeably. */
  .ide-mock {
    position: relative;
    margin-top: var(--space-4);
    width: 100%;
    max-width: 900px;
    text-align: left;
    border-radius: var(--radius-xl);
    background: var(--bg-secondary);
    overflow: hidden;
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.45);
  }

  .ide-mock-tabs {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 40px;
    padding: 0 var(--space-4);
    background: var(--bg-tertiary);
    border-bottom: 1px solid var(--border-color);
  }

  .ide-mock-tab {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .ide-mock-tab-active {
    color: var(--text-primary);
    border-bottom: 2px solid var(--accent-cyan);
  }

  .ide-mock-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--text-muted);
  }

  .ide-mock-body {
    display: flex;
    height: 340px;
  }

  .ide-mock-files {
    width: 160px;
    flex-shrink: 0;
    background: var(--bg-primary);
    border-right: 1px solid var(--border-color);
    padding: var(--space-4) var(--space-3);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 2.1;
  }

  .ide-mock-file-active {
    color: var(--text-primary);
    font-weight: 600;
    padding-left: 14px;
  }

  .ide-mock-files div:nth-child(3),
  .ide-mock-files div:nth-child(4) {
    padding-left: 14px;
  }

  .ide-mock-code {
    flex: 1;
    padding: var(--space-4) var(--space-6);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.85;
    overflow: hidden;
  }

  .ide-mock-line-no {
    display: inline-block;
    width: 20px;
    margin-right: var(--space-4);
    color: var(--text-muted);
  }

  .ide-mock-kw {
    color: var(--accent-cyan);
  }

  .ide-mock-str {
    color: var(--color-success);
  }

  .ide-mock-cursor {
    display: inline-block;
    width: 8px;
    height: 15px;
    margin-left: 2px;
    vertical-align: middle;
    background: var(--accent-cyan);
    animation: ide-mock-blink 1s step-end infinite;
  }

  @keyframes ide-mock-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  .ide-mock-agent {
    width: 220px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--bg-secondary);
    border-left: 1px solid var(--border-color);
  }

  .ide-mock-agent-status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .ide-mock-agent-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent-cyan);
    animation: ide-mock-pulse 1.6s ease-in-out infinite;
  }

  @keyframes ide-mock-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .ide-mock-bubble {
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-primary);
  }

  .ide-mock-bubble-user {
    align-self: flex-end;
    max-width: 90%;
    background: var(--bg-tertiary);
  }

  .ide-mock-bubble-agent {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
  }

  .ide-mock-agent-actions {
    display: flex;
    gap: var(--space-2);
  }

  .ide-mock-approve,
  .ide-mock-reject {
    flex: 1;
    padding: var(--space-2) 0;
    font-size: 12px;
    cursor: default;
  }

  @media (max-width: 860px) {
    .ide-mock-body {
      height: auto;
      flex-direction: column;
    }

    .ide-mock-files {
      display: none;
    }

    .ide-mock-agent {
      width: 100%;
      border-left: none;
      border-top: 1px solid var(--border-color);
    }
  }

  .showcase {
    padding: var(--space-16) 0 var(--space-8);
  }

  .showcase-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-8);
  }

  .feature-block {
    display: flex;
    gap: var(--space-8);
    align-items: baseline;
    padding-bottom: var(--space-12);
    margin-bottom: var(--space-12);
    border-bottom: 1px solid var(--border-color);
  }

  .feature-block:last-child {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: none;
  }

  .feature-fig {
    flex-shrink: 0;
    width: 64px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent-cyan);
  }

  .feature-block-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    width: 100%;
  }

  .feature-block h2 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-3);
  }

  .feature-block p {
    color: var(--text-secondary);
    font-size: var(--font-size-base);
    line-height: 1.7;
    margin-bottom: var(--space-4);
    max-width: 560px;
  }

  .feature-demo {
    flex-shrink: 0;
    width: 380px;
    height: 238px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
  }

  @media (max-width: 900px) {
    .feature-block-body {
      flex-direction: column;
      align-items: flex-start;
    }

    .feature-demo {
      width: 100%;
      height: auto;
    }
  }

  .showcase-link {
    color: var(--accent-cyan);
    font-weight: 600;
    font-size: var(--font-size-sm);
  }

  .showcase-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .feature-block {
      flex-direction: column;
      gap: var(--space-2);
    }
  }

  .pillars {
    padding: var(--space-8) 0;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-6);
  }

  .pillar-card {
    padding: var(--space-6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    transition: var(--transition-smooth);
  }

  .pillar-card:hover {
    border-color: var(--accent-purple);
  }

  .pillar-card h3 {
    font-size: var(--font-size-md);
    margin-bottom: var(--space-2);
  }

  .pillar-card p {
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.6;
  }

  .faq {
    padding: var(--space-8) 0 var(--space-24);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 720px;
  }

  .faq-item {
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    transition: var(--transition-smooth);
  }

  .faq-item:hover {
    border-color: var(--accent-purple);
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    font-size: var(--font-size-base);
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    font-family: var(--font-mono);
    font-size: var(--font-size-lg);
    color: var(--accent-cyan);
    flex-shrink: 0;
    margin-left: var(--space-4);
  }

  .faq-item[open] summary::after {
    content: '−';
  }

  .faq-item p {
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.7;
    margin-top: var(--space-3);
  }
</style>
