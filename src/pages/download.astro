---
import Layout from '../layouts/Layout.astro';
import { getLatestRelease, getAllReleases } from '../lib/releases';

const [release, allReleases] = await Promise.all([getLatestRelease(), getAllReleases()]);

// Real installer downloads only (see getAllReleases' own comment) — summed across every
// published version, not just the current one.
const totalDownloads = allReleases.reduce((sum, r) => sum + r.downloadCount, 0);

const numberFormat = new Intl.NumberFormat('en-US');
const pluralDownloads = (n: number) => (n === 1 ? 'download' : 'downloads');

const platforms = [
  {
    name: 'Windows',
    requirement: 'Windows 10 or later, 64-bit',
    assetUrl: release.windowsAssetUrl,
    downloadCount: release.windowsDownloadCount,
  },
  {
    name: 'macOS',
    requirement: 'macOS 11 (Big Sur) or later',
    assetUrl: release.macAssetUrl,
    downloadCount: release.macDownloadCount,
  },
];
---

<Layout title="Download" description="Download SDE Code for Windows or macOS.">
  <section class="container download-page">
    <span class="eyebrow">{release.version ? `Version ${release.version}` : 'No build published yet'}</span>
    <h1>Download SDE Code</h1>
    {!release.releaseUrl && (
      <p class="version-line">Check back soon — the first build is on its way.</p>
    )}
    {totalDownloads > 0 && (
      <p class="total-downloads">{numberFormat.format(totalDownloads)} {pluralDownloads(totalDownloads)} across all versions</p>
    )}

    <div class="platform-grid">
      {platforms.map((p) => (
        <div class="platform-card tick-frame">
          <span class="tick tick-tl" aria-hidden="true"></span>
          <span class="tick tick-tr" aria-hidden="true"></span>
          <span class="tick tick-bl" aria-hidden="true"></span>
          <span class="tick tick-br" aria-hidden="true"></span>
          <span class="platform-badge">{p.name}</span>
          <p class="requirement">{p.requirement}</p>
          {p.assetUrl ? (
            <a class="btn btn--primary" href={p.assetUrl}>Download for {p.name}</a>
          ) : (
            <button class="btn btn--primary" disabled>Coming soon</button>
          )}
          {typeof p.downloadCount === 'number' && (
            <p class="download-count">{numberFormat.format(p.downloadCount)} {pluralDownloads(p.downloadCount)} (this version)</p>
          )}
        </div>
      ))}
    </div>

    <p class="source-note">
      Looking for an older build? See <a href="/versions">all versions</a>.
    </p>
  </section>
</Layout>

<style>
  .download-page {
    padding: var(--space-16) var(--space-6) var(--space-24);
  }

  .download-page h1 {
    font-size: clamp(1.75rem, 4vw + 1rem, var(--font-size-2xl));
    margin: var(--space-4) 0 var(--space-3);
  }

  .version-line {
    color: var(--text-secondary);
    margin-bottom: var(--space-12);
  }

  .version-line a {
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .total-downloads {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-12);
  }

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .platform-card {
    position: relative;
    padding: var(--space-8);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    transition: var(--transition-smooth);
  }

  .platform-card:hover {
    border-color: var(--accent-purple);
  }

  .platform-badge {
    display: inline-block;
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .requirement {
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-6);
  }

  .download-count {
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    margin-top: var(--space-3);
  }

  .source-note {
    margin-top: var(--space-16);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .source-note a {
    color: var(--accent-cyan);
  }
</style>
