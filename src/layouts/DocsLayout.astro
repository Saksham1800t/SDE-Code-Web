---
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  currentSlug: string;
}

const { title, description, currentSlug } = Astro.props;
const allDocs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title={title} description={description}>
  <div class="container docs-shell">
    <nav class="docs-sidebar" aria-label="Documentation">
      <ul>
        {allDocs.map((doc) => (
          <li>
            <a href={`/docs/${doc.id}`} aria-current={doc.id === currentSlug ? 'page' : undefined}>
              {doc.data.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <article class="docs-content">
      <h1>{title}</h1>
      <slot />
    </article>
  </div>
</Layout>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-12);
    padding: var(--space-12) var(--space-6) var(--space-24);
    align-items: start;
  }

  .docs-sidebar {
    position: sticky;
    top: 88px;
  }

  .docs-sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .docs-sidebar a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
  }

  .docs-sidebar a:hover {
    color: var(--text-primary);
    background: var(--bg-secondary);
  }

  .docs-sidebar a[aria-current='page'] {
    color: var(--accent-cyan);
    background: var(--bg-secondary);
    font-weight: 600;
  }

  .docs-content {
    min-width: 0;
    max-width: 760px;
  }

  .docs-content h1 {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-6);
  }

  .docs-content :global(h2) {
    font-size: var(--font-size-lg);
    margin: var(--space-12) 0 var(--space-4);
  }

  .docs-content :global(h3) {
    font-size: var(--font-size-md);
    margin: var(--space-8) 0 var(--space-3);
  }

  .docs-content :global(p) {
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .docs-content :global(ul),
  .docs-content :global(ol) {
    color: var(--text-secondary);
    margin: 0 0 var(--space-4);
    padding-left: var(--space-8);
  }

  .docs-content :global(li) {
    margin-bottom: var(--space-2);
  }

  .docs-content :global(code) {
    background: var(--bg-tertiary);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
  }

  .docs-content :global(pre) {
    background: var(--bg-tertiary);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: var(--space-4);
  }

  .docs-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .docs-content :global(img) {
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    margin: var(--space-4) 0;
  }

  .docs-content :global(strong) {
    color: var(--text-primary);
  }

  @media (max-width: 720px) {
    .docs-shell {
      grid-template-columns: 1fr;
    }
    .docs-sidebar {
      position: static;
    }
  }
</style>
