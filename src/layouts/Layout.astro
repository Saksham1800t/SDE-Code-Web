---
import '../styles/global.css';
import { PRODUCT_NAME } from '../config';

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative image URL for social share cards. */
  image?: string;
}

const { title, description, image = '/og-image.png' } = Astro.props;
const pageTitle = `${title} · ${PRODUCT_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/sde-taskbar-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#08090c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PRODUCT_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: PRODUCT_NAME,
      url: Astro.site?.toString(),
    })} />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a href="/" class="brand">
          <img src="/sde-mark.png" width="24" height="24" alt="" />
          <span>{PRODUCT_NAME}</span>
        </a>
        <nav class="site-nav" id="site-nav">
          <a href="/download">Download</a>
          <a href="/versions">Versions</a>
          <a href="/docs">Docs</a>
        </nav>
        <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Toggle navigation menu">
          <span class="nav-toggle-bar" aria-hidden="true"></span>
          <span class="nav-toggle-bar" aria-hidden="true"></span>
          <span class="nav-toggle-bar" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <main data-pagefind-body>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer-inner">
        <span>&copy; {new Date().getFullYear()} {PRODUCT_NAME}</span>
      </div>
    </footer>

    <script>
      const navToggle = document.getElementById('nav-toggle');
      const siteNav = document.getElementById('site-nav');
      navToggle?.addEventListener('click', () => {
        const isOpen = siteNav?.classList.toggle('open');
        navToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
      });
      // Close the mobile menu after following a link, so it doesn't stay open on the next page.
      siteNav?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).tagName === 'A') {
          siteNav.classList.remove('open');
          navToggle?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>

    <style>
      .site-header {
        border-bottom: 1px solid var(--border-color);
        position: sticky;
        top: 0;
        /* Solid, not translucent+blurred — backdrop-filter combined with the sticky
           sidebar/ToC on docs pages triggers a real Chrome GPU-compositing bug on some
           Windows drivers that renders the content column as a solid blank box. */
        background: var(--bg-primary);
        z-index: 10;
      }

      .site-header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-weight: 700;
        font-size: var(--font-size-md);
      }

      .site-nav {
        display: flex;
        align-items: center;
        gap: var(--space-8);
      }

      .site-nav a {
        color: var(--text-secondary);
        font-size: var(--font-size-sm);
        font-weight: 500;
        transition: var(--transition-smooth);
      }

      .site-nav a:hover {
        color: var(--text-primary);
      }

      .nav-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 32px;
        height: 32px;
        padding: 0;
        border: none;
        background: none;
        cursor: pointer;
      }

      .nav-toggle-bar {
        display: block;
        width: 100%;
        height: 2px;
        border-radius: 1px;
        background: var(--text-primary);
      }

      @media (max-width: 640px) {
        .nav-toggle {
          display: flex;
        }

        .site-nav {
          display: none;
          position: absolute;
          top: 64px;
          left: 0;
          right: 0;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          background: var(--bg-primary);
          border-bottom: 1px solid var(--border-color);
          padding: var(--space-2) var(--space-6) var(--space-4);
        }

        .site-nav.open {
          display: flex;
        }

        .site-nav a {
          padding: var(--space-3) 0;
          border-top: 1px solid var(--border-color);
        }

        .site-nav a:first-child {
          border-top: none;
        }
      }

      .site-footer {
        border-top: 1px solid var(--border-color);
        margin-top: var(--space-24);
      }

      .site-footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
        color: var(--text-muted);
        font-size: var(--font-size-sm);
      }

      .site-footer-inner a {
        color: var(--text-muted);
      }

      .site-footer-inner a:hover {
        color: var(--text-primary);
      }
    </style>
  </body>
</html>
