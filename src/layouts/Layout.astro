---
import '../styles/global.css';
import { PRODUCT_NAME, GITHUB_URL } from '../config';

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative image URL for social share cards. Defaults to the logo mark — no dedicated 1200×630 social card exists yet. */
  image?: string;
}

const { title, description, image = '/sde-mark.png' } = Astro.props;
const pageTitle = `${title} · ${PRODUCT_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/sde-taskbar-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#08090c" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PRODUCT_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1100" />
    <meta property="og:image:height" content="1100" />
    <meta property="og:image:alt" content={`${PRODUCT_NAME} logo`} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={`${PRODUCT_NAME} logo`} />

    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a href="/" class="brand">
          <img src="/sde-mark.png" width="24" height="24" alt="" />
          <span>{PRODUCT_NAME}</span>
        </a>
        <nav class="site-nav">
          <a href="/download">Download</a>
          <a href="/versions">Versions</a>
          <a href="/docs">Docs</a>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
      </div>
    </header>

    <main data-pagefind-body>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer-inner">
        <span>&copy; {new Date().getFullYear()} {PRODUCT_NAME}</span>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--border-color);
        position: sticky;
        top: 0;
        background: color-mix(in srgb, var(--bg-primary) 90%, transparent);
        backdrop-filter: blur(8px);
        z-index: 10;
      }

      .site-header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-weight: 700;
        font-size: var(--font-size-md);
      }

      .site-nav {
        display: flex;
        align-items: center;
        gap: var(--space-8);
      }

      .site-nav a {
        color: var(--text-secondary);
        font-size: var(--font-size-sm);
        font-weight: 500;
        transition: var(--transition-smooth);
      }

      .site-nav a:hover {
        color: var(--text-primary);
      }

      .site-footer {
        border-top: 1px solid var(--border-color);
        margin-top: var(--space-24);
      }

      .site-footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
        color: var(--text-muted);
        font-size: var(--font-size-sm);
      }

      .site-footer-inner a {
        color: var(--text-muted);
      }

      .site-footer-inner a:hover {
        color: var(--text-primary);
      }
    </style>
  </body>
</html>
